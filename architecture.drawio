          <mxGeometry x="20" y="174" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pcpp_detail" value="update(dt)&#xa;  add gravity to force&#xa;  call velvetIntPart(*this, dt)&#xa;  kineticEnergy = 0.5 * m * v^2&#xa;  colour = velocityToColour(v)&#xa;checkBounds(w, h)&#xa;  elastic walls: v *= WALL_RESTITUTION&#xa;draw()  -&gt; window.draw(shape)"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_particle">
