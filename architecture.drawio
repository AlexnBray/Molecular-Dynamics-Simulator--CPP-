        <!-- ================== PHYSICS LAYER ================== -->

        <!-- grid_particle.cpp -->
        <mxCell id="grid" value="grid_particle.cpp - Spatial Physics"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="20" y="36" width="360" height="270" as="geometry" />
        </mxCell>
        <mxCell id="grid_detail" value="buildNeighbourList()  O(n) average&#xa;  - Uniform grid via unordered_map&#xa;  - Cell key = (cx &lt;&lt; 32) XOR cy  (64-bit)&#xa;  - Bucket each particle into one cell&#xa;  - 3x3 cell neighbourhood probe&#xa;  - SKIN_RADIUS^2 distance filter&#xa;  - Returns: neighbourVector&#xa;&#xa;calcNeighbourInteractions()&#xa;  - Reset all forces to zero&#xa;  - LJ force: repulsive r&lt;sigma, attractive r&gt;sigma&#xa;  - Hard-sphere collision:&#xa;      positional correction (80%, slop 0.01)&#xa;      velocity impulse (restitution 0.65)&#xa;      tangential friction (4% of normal)"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="20" y="36" width="360" height="270" as="geometry" />
        </mxCell>

        <!-- lj_potential.cpp -->
        <mxCell id="lj" value="lj_potential.cpp - Force Model"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="400" y="36" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lj_detail" value="calcLennardJonesForce(dist2)&#xa;  F = 48*eps * [ (sig/r)^12 - 0.5*(sig/r)^6 ] / r^2&#xa;  Cutoff enforced at r = 2.5 * sigma&#xa;  Returns scalar magnitude (applied along delta)"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="400" y="36" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- velocity_velvet_int.cpp -->
        <mxCell id="verlet" value="velocity_velvet_int.cpp - Integrator"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="400" y="174" width="360" height="132" as="geometry" />
        </mxCell>
        <mxCell id="verlet_detail" value="velvetIntPart(particle, dt)&#xa;  a  = F / m&#xa;  v(t+dt) = v + a * dt         (symplectic Euler)&#xa;  x(t+dt) = x + v(t+dt) * dt&#xa;  Returns {newVelocity, newPosition}"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_physics">
          <mxGeometry x="400" y="174" width="360" height="132" as="geometry" />
        </mxCell>

