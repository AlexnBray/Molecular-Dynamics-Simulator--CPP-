          vertex="1" parent="1">
          <mxGeometry x="20" y="576" width="1380" height="140" as="geometry" />
        </mxCell>

        <!-- ================== CONSTANTS.H ================== -->
        <mxCell id="constants" value="constants.h - Centralised Configuration"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="20" y="36" width="260" height="104" as="geometry" />
        </mxCell>
        <mxCell id="constants_detail" value="GRAVITY = 9.80665&#xa;PARTICLE_RADIUS = 5  |  PARTICLE_MASS = 1&#xa;LJ_EPSILON = 10  |  LJ_SIGMA = 2.3 * r&#xa;LJ_CUTOFF = 2.5 * sigma&#xa;SKIN_RADIUS = max(LJ_CUTOFF, 2r) * 1.2&#xa;COLLISION_RESTITUTION = 0.65  |  FRICTION = 0.04&#xa;simWidth=1200  simHeight=800  windowWidth=1500"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="20" y="36" width="260" height="104" as="geometry" />
        </mxCell>

        <!-- main.cpp in infra band -->
        <mxCell id="main" value="main.cpp - Application Orchestrator"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="300" y="36" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="main_detail" value="Fixed-timestep loop: fixedDt = 1/60 s, accumulator pattern, cap at 250 ms&#xa;Event handling (close, pause)   |   Mouse-click spawn: 500 particles per click&#xa;Physics tick: buildNeighbourList -> calcNeighbourInteractions x3 -> p.update -> p.checkBounds&#xa;Metrics: rolling FPS, chrono physics-step ms, totalKineticEnergy, totalLJPotentialEnergy&#xa;Render: window.clear -> simBox -> particles -> hud.draw -> window.display"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="300" y="36" width="760" height="104" as="geometry" />
        </mxCell>

        <!-- utils.cpp in infra band -->
        <mxCell id="utils" value="utils.cpp - Shared Helpers"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#006064;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="1080" y="36" width="280" height="104" as="geometry" />
        </mxCell>
        <mxCell id="utils_detail" value="cellCoord(pos, cellSize) -&gt; (cx, cy)&#xa;velocityToColour()  blue -&gt; white -&gt; red&#xa;gradientCalc()  lerp sf::Color&#xa;clickTime()  spawn cooldown (chrono)&#xa;randomDistributionX/Y()&#xa;calcDistSqr()  |  calcDelta()"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
          vertex="1" parent="bg_infra">
          <mxGeometry x="1080" y="36" width="280" height="104" as="geometry" />
