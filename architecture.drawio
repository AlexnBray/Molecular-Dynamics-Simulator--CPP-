          vertex="1" parent="bg_particle">
          <mxGeometry x="20" y="36" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="struct_detail" value="position  : sf::Vector2f&#xa;velocity  : sf::Vector2f&#xa;force     : sf::Vector2f&#xa;kineticEnergy : double&#xa;shape     : sf::CircleShape"
          style="text;html=0;strokeColor=none;fillColor=none;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;"
